--- a/arch/arm/boot/dts/broadcom/bcm2710-rpi-zero-2-w.dts
+++ b/arch/arm/boot/dts/broadcom/bcm2710-rpi-zero-2-w.dts
@@ -255,3 +255,71 @@ __overrides__ {
 		act_led_trigger = <&led_act>,"linux,default-trigger";
 	};
 };
+
+&spidev0 {
+	status = "disabled";
+};
+
+&gpio {
+	status = "okay";
+
+	ili9225_pins: ili9225_pins {
+		brcm,pins = <24 25>;        /* GPIO24=reset, GPIO25=rs */
+		brcm,function = <1>;        /* 1 = output */
+		brcm,pull = <0>;            /* no pull */
+	};
+
+	cafe_button_pins: cafe_button_pins {
+		brcm,pins = <22 23 17>;
+		brcm,function = <1>;
+		brcm,pull = <0>;
+	};
+
+	cafe_led_pins: cafe_led_pins {
+		brcm,pins = <18>;
+		brcm,function = <0>;
+		brcm,pull = <0>;
+	};
+
+	cafe_com {
+		compatible = "devlinux,cafecom";
+		pinctrl-names = "default";
+		pinctrl-0 = <&cafe_button_pins &cafe_led_pins>;
+
+		power-gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
+		led-gpios = <&gpio 18>;
+		halfcup-gpios = <&gpio 22 GPIO_ACTIVE_LOW>;
+		fullcup-gpios = <&gpio 23 GPIO_ACTIVE_LOW>;
+		status = "okay";
+	};
+};
+
+&spi0 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ili9225: display@0 {
+		compatible = "vot,v220hf01a-t", "ilitek,ili9225";
+		reg = <0>;                          /* CE0 chip select */
+		pinctrl-names = "default";
+		pinctrl-0 = <&ili9225_pins>;
+
+		spi-max-frequency = <6000000>;
+
+		reset-gpios = <&gpio 24 GPIO_ACTIVE_HIGH>;
+		rs-gpios = <&gpio 25 GPIO_ACTIVE_HIGH>;  /* Data/Command line */
+		rotation = <270>;
+		status = "okay";
+	};
+};
+
+&i2c1 {
+	status = "okay";
+
+	sh1106:sh1106@3c {
+		compatible = "solomon,sh1106";
+ 		reg = <0x3c>;
+ 		status = "okay";
+ 	};
+};
