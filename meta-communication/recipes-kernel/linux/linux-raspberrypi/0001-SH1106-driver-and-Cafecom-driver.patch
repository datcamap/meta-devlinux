+static int sh1106_send_command(sh1106_i2c_device_t *, uint8_t);
+static int sh1106_send_data(sh1106_i2c_device_t *, char*, uint16_t);
+static int sh1106_set_cursor(sh1106_i2c_device_t *, uint8_t, uint8_t);
+void sh1106_display_print_string(sh1106_i2c_device_t *, const char *, size_t);
+void sh1106_display_fill_remaining(sh1106_i2c_device_t *, uint8_t);
