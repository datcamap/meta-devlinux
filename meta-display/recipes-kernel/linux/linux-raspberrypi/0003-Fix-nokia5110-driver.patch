+
+static int ssd1306_probe(struct i2c_client *client);
+static int ssd1306_remove(struct i2c_client *client);
+void ssd1306_init_sequence(ssd1306_i2c_device_t *);
+static int ssd1306_send_command(ssd1306_i2c_device_t *, uint8_t);
+static int ssd1306_send_data(ssd1306_i2c_device_t *, char*, uint16_t);
+static int ssd1306_set_cursor(ssd1306_i2c_device_t *, uint8_t, uint8_t);
+void ssd1306_display_print_string(ssd1306_i2c_device_t *, const char *, size_t);
+void ssd1306_display_fill_remaining(ssd1306_i2c_device_t *, uint8_t);
+void ssd1306_cleanup(ssd1306_i2c_device_t *);
+
+static int ssd1306_open(struct inode *, struct file *);
+static int ssd1306_release(struct inode *, struct file *);
+static ssize_t ssd1306_write(struct file *, const char __user *, size_t, loff_t *);
+
+static struct file_operations fops = {
+    .open = ssd1306_open,
+    .release = ssd1306_release,
+    .write = ssd1306_write,
+};
+
+static int ssd1306_probe(struct i2c_client *client) {
+    ssd1306_i2c_device_t *ssd1306;
+    char* test_str = "Hello, World!\n";
+
+    ssd1306 = (ssd1306_i2c_device_t *)kmalloc(sizeof(ssd1306_i2c_device_t), GFP_KERNEL);
+    if (!ssd1306) {
+        return -ENOMEM;
+    }
+
+    ssd1306->kmalloc_ptr = (char *)kmalloc(KBUFFER_CAP, GFP_KERNEL);
+    if (ssd1306->kmalloc_ptr == NULL) {
+        printk(KERN_ERR "Cannot allocate kernel buffer.\n");
+        goto ssd1306_fail;
+    }
+
+    cdev_init(&ssd1306->my_cdev, &fops);
+    ssd1306->dev_num = MKDEV(MAJOR(ssd1306_module.major), ssd1306_module.minor);
+    if (cdev_add(&ssd1306->my_cdev, ssd1306->dev_num, 1)) {
+        printk(KERN_ERR "Failed to add device.\n");
+        goto cdev_add_fail;
+    }
+    ssd1306_module.minor++;
+
+    if (device_create(ssd1306_module.my_class, NULL, ssd1306->dev_num, NULL, "%s%d", DEVICE_NAME, MINOR(ssd1306->dev_num)) == NULL) {
+         printk(KERN_ERR "Cannot create device.\n");
+         goto device_create_fail;
+    }
+
+    ssd1306->kbuf_len = 0;
+    ssd1306->client = client;
+    ssd1306->current_line = 0;
+    ssd1306->cursor_pos = 0;
+    ssd1306->font_size = 5 + SSD1306_FONT_SPACING;
+
+    i2c_set_clientdata(client, ssd1306);
+    ssd1306_init_sequence(ssd1306);
+    ssd1306_cleanup(ssd1306);
+    ssd1306_display_print_string(ssd1306, test_str, sizeof(test_str) - 1);
+
+    printk(KERN_INFO DEVICE_NAME ": I2C device is detected.\n");
+    return 0;
+
+    device_create_fail:
+    cdev_del(&ssd1306->my_cdev);
+    cdev_add_fail:
+    kfree(ssd1306->kmalloc_ptr);
+    ssd1306_fail:
+    kfree(ssd1306);
+    return -1;
+}
+
+static int ssd1306_remove(struct i2c_client *client) {
+    ssd1306_i2c_device_t *ssd1306 = i2c_get_clientdata(client);
+    if (!ssd1306) {
+        return -EINVAL;
+    }
+
+    device_destroy(ssd1306_module.my_class, ssd1306->dev_num);
+    cdev_del(&ssd1306->my_cdev);
+    kfree(ssd1306->kmalloc_ptr);
+    kfree(ssd1306);
+
+    printk(KERN_INFO DEVICE_NAME ": I2C device is removed.\n");
+    return 0;
+}
+
+void ssd1306_init_sequence(ssd1306_i2c_device_t *ssd1306) {
+    //msleep(100);
+
+    ssd1306_send_command(ssd1306, 0xAE); // Set display OFF		
+ 
+    ssd1306_send_command(ssd1306, 0xD5); // Set Display Clock Divide Ratio / OSC Frequency
+    ssd1306_send_command(ssd1306, 0x80); // Display Clock Divide Ratio / OSC Frequency 
+ 
+    ssd1306_send_command(ssd1306, 0xA8); // Set Multiplex Ratio
+    ssd1306_send_command(ssd1306, 0x3F); // Multiplex Ratio for 128x64 (64-1)
+ 
+    ssd1306_send_command(ssd1306, 0xD3); // Set Display Offset
+    ssd1306_send_command(ssd1306, 0x00); // Display Offset
+ 
+    ssd1306_send_command(ssd1306, 0x40); // Set Display Start Line
+ 
+    ssd1306_send_command(ssd1306, 0x8D); // Set Charge Pump
+    ssd1306_send_command(ssd1306, 0x14); // Charge Pump (0x10 External, 0x14 Internal DC/DC)
+ 
+    ssd1306_send_command(ssd1306, 0xA1); // Set Segment Re-Map
+    ssd1306_send_command(ssd1306, 0xC8); // Set Com Output Scan Direction
+ 
+    ssd1306_send_command(ssd1306, 0xDA); // Set COM Hardware Configuration
+    ssd1306_send_command(ssd1306, 0x12); // COM Hardware Configuration
+ 
+    ssd1306_send_command(ssd1306, 0x81); // Set Contrast
+    ssd1306_send_command(ssd1306, 0xCF); // Contrast
+ 
+    ssd1306_send_command(ssd1306, 0xD9); // Set Pre-Charge Period
+    ssd1306_send_command(ssd1306, 0xF1); // Set Pre-Charge Period (0x22 External, 0xF1 Internal)
+ 
+    ssd1306_send_command(ssd1306, 0xDB); // Set VCOMH Deselect Level
+    ssd1306_send_command(ssd1306, 0x40); // VCOMH Deselect Level
+ 
+    ssd1306_send_command(ssd1306, 0xA4); // Set all pixels OFF
+    ssd1306_send_command(ssd1306, 0xA6); // Set display not inverted
+    ssd1306_send_command(ssd1306, 0xAF); // Set display On
+}
+
+static int ssd1306_send_command(ssd1306_i2c_device_t *ssd1306, uint8_t command) {
+    char buf[2];
+    buf[0] = SSD1306_CTRL_CMD;
+    buf[1] = command;
+    return i2c_master_send(ssd1306->client, buf, 2);
+}
+
+static int ssd1306_send_data(ssd1306_i2c_device_t *ssd1306, char *data_buf, uint16_t buf_len) {
+    while (buf_len > 0) {
+        int chunk_len = min((int)buf_len, 16);
+        uint8_t buf[1 + 16];
+        int ret;
+
+        buf[0] = SSD1306_CTRL_DATA;
+        memcpy(&buf[1], data_buf, chunk_len);
+
+        ret = i2c_master_send(ssd1306->client, buf, chunk_len + 1);
+        if (ret != chunk_len + 1) {
+            return (ret < 0) ? ret : -EIO;
+        }
+
+        data_buf += chunk_len;
+        buf_len  -= chunk_len;
+    }
+
+    return 0;
+}
+
+static int ssd1306_set_cursor(ssd1306_i2c_device_t *ssd1306, uint8_t line, uint8_t pos) {
+    if (line > SSD1306_MAX_LINE || pos > SSD1306_MAX_SEG) {
+        printk(KERN_ERR DEVICE_NAME ": Invalid cursor position (line: %d, pos: %d)\n", line, pos);
+        return -EINVAL;
+    }
+    ssd1306->current_line = line;
+    ssd1306->cursor_pos = pos;
+
+    ssd1306_send_command(ssd1306, 0xB0 | line); // Set page address
+    ssd1306_send_command(ssd1306, 0x00 | (pos & 0x0F)); // Set lower column address
+    ssd1306_send_command(ssd1306, 0x10 | ((pos >> 4) & 0x0F)); // Set higher column address
+
+    return 0;
+}
+
+void ssd1306_display_print_string(ssd1306_i2c_device_t *ssd1306, const char *str, size_t len) {
+    char *str_temp;
+    char *kbuffer;
+    size_t i, j;
+    uint16_t kbuf_index = 0;
+
+    str_temp = (char *)kmalloc(len + 1, GFP_KERNEL);
+    if (!str_temp) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to allocate memory for string copy.\n");
+        return;
+    }
+    strncpy(str_temp, str, len);
+    str_temp[len] = '\0';
+
+    kbuffer = (char *)kmalloc(ssd1306->font_size * len, GFP_KERNEL);
+    if (!kbuffer) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to allocate memory for string rendering.\n");
+        return;
+    }
+
+    for (i = 0; i < len; i++) {
+        if (str_temp[i] == '\n') {
+            ssd1306_display_fill_remaining(ssd1306, ssd1306->cursor_pos);
+            ssd1306->current_line++;
+            ssd1306->cursor_pos = 0;
+            if (ssd1306->current_line > SSD1306_MAX_LINE) {
+                ssd1306->current_line = 0;
+            }
+            ssd1306_set_cursor(ssd1306, ssd1306->current_line, ssd1306->cursor_pos);
+            continue;
+        } else if (str_temp[i] < 0x20 || str_temp[i] > 0x7E) {
+            str_temp[i] = '?'; // Replace unsupported characters with '?'
+        }
+
+        // Render characters to kbuffer
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][0];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][1];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][2];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][3];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][4];
+        for (j = 0; j < SSD1306_FONT_SPACING; j++) {
+            kbuffer[kbuf_index++] = 0x00; // Add spacing between characters
+        }
+
+        ssd1306_send_data(ssd1306, kbuffer, ssd1306->font_size);
+        kbuf_index = 0;
+        ssd1306->cursor_pos += ssd1306->font_size;
+
+        // Prepare for next character
+        if (ssd1306->cursor_pos + ssd1306->font_size > SSD1306_MAX_SEG) {
+            ssd1306_display_fill_remaining(ssd1306, ssd1306->cursor_pos);
+            ssd1306->current_line++;
+            ssd1306->cursor_pos = 0;
+            if (ssd1306->current_line > SSD1306_MAX_LINE) {
+                ssd1306->current_line = 0;
+            }
+        }
+        ssd1306_set_cursor(ssd1306, ssd1306->current_line, ssd1306->cursor_pos);
+    }
+}
+
+void ssd1306_display_fill_remaining(ssd1306_i2c_device_t *ssd1306, uint8_t pos) {
+    uint8_t remaining_bytes = SSD1306_MAX_SEG - pos;
+    char *clear_buf;
+
+    clear_buf = (char *)kmalloc(remaining_bytes, GFP_KERNEL);
+    if (!clear_buf) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to allocate memory for clearing display.\n");
+        return;
+    }
+    
+    memset(clear_buf, 0x00, remaining_bytes);
+    printk(KERN_INFO DEVICE_NAME ": Filling remaining %d bytes on line %d from position %d\n", remaining_bytes, ssd1306->current_line, pos);
+
+    ssd1306_send_data(ssd1306, clear_buf, remaining_bytes);
+    kfree(clear_buf);
+}
+
+void ssd1306_cleanup(ssd1306_i2c_device_t *ssd1306) {
+    int line;
+
+    for (line = 0; line <= SSD1306_MAX_LINE; line++) {
+        ssd1306_set_cursor(ssd1306, line, 0);
+        ssd1306_display_fill_remaining(ssd1306, 0);
+    }
+    ssd1306_set_cursor(ssd1306, 0, 0);
+}
+
+static int ssd1306_open(struct inode *inode, struct file *file) {
+    ssd1306_i2c_device_t *ssd1306 = container_of(inode->i_cdev, ssd1306_i2c_device_t, my_cdev);
+    file->private_data = ssd1306;
+
+    printk(KERN_INFO DEVICE_NAME ": open\n");
+    return 0;
+}
+
+static int ssd1306_release(struct inode *inode, struct file *file) {
+    printk(KERN_INFO DEVICE_NAME ": release\n");
+    return 0;
+}
+
+static ssize_t ssd1306_write(struct file *file, const char __user *user_buf, size_t size, loff_t *offset) {
+    ssd1306_i2c_device_t *ssd1306 = (ssd1306_i2c_device_t *)file->private_data;
+
+    int bytes_write = size;
+    if (size > KBUFFER_CAP - 1) {
+        bytes_write = KBUFFER_CAP - 1;
+    }
+    if (copy_from_user(ssd1306->kmalloc_ptr, user_buf, bytes_write)) {
+        return -1;
+    }
+    ssd1306->kmalloc_ptr[bytes_write] = '\0';
+    ssd1306_display_print_string(ssd1306, ssd1306->kmalloc_ptr, bytes_write);
+    printk(DEVICE_NAME ": received %d bytes from user\n", bytes_write);
+
+    return bytes_write;
+}
+
+static const struct of_device_id ssd1306_of_match[] = {
+    { .compatible = "solomon,ssd1306" },
+    { }
+};
+
+static struct i2c_driver ssd1306_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .owner = THIS_MODULE,
+        .of_match_table = ssd1306_of_match
+    },
+    .probe_new = ssd1306_probe,
+    .remove = ssd1306_remove,
+};
+
+static int __init ssd1306_init(void)
+{   
+    if ((ssd1306_module.my_class = class_create(THIS_MODULE, CLASS_NAME)) == NULL) {
+        printk(KERN_ERR "Cannot create class.\n");
+        return -1;
+    }
+    if (alloc_chrdev_region(&ssd1306_module.major, 0, MAX_MINOR, DEVICE_NAME) < 0) {
+        printk(KERN_ERR "Cannot allocate kernel device.\n");
+        class_destroy(ssd1306_module.my_class);
+        return -1;
+    }
+    ssd1306_module.minor = 0;
+    
+    if (i2c_add_driver(&ssd1306_driver)) {
+        printk(KERN_ERR "i2c_add_driver failed. \n");
+        class_destroy(ssd1306_module.my_class);
+        unregister_chrdev_region(ssd1306_module.major, MAX_MINOR);
+        return -1;
+    }
+
+    printk(KERN_INFO "Hello, Kernel World!\n");
+    return 0;
+}
+
+static void __exit ssd1306_exit(void)
+{
+    i2c_del_driver(&ssd1306_driver);
+
+    class_destroy(ssd1306_module.my_class);
+    unregister_chrdev_region(ssd1306_module.major, MAX_MINOR);
+    printk(KERN_INFO "Module removed.\n");
+}
+
+module_init(ssd1306_init);
+module_exit(ssd1306_exit);
+
+// Module metadata
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("DataD");
+MODULE_DESCRIPTION("A simple ssd1306 driver");
