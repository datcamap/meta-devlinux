+static int nokia5110_probe(struct spi_device *);
+static int nokia5110_remove(struct spi_device *);
+void nokia5110_init_sequence(nokia5110_spi_device_t *);
+static int nokia5110_send_cmd(nokia5110_spi_device_t *, uint8_t);
+static int nokia5110_send_data(nokia5110_spi_device_t *, char*, size_t);
+static int nokia5110_set_column_address(nokia5110_spi_device_t *, uint8_t, uint8_t);
+void nokia5110_display_print_string(nokia5110_spi_device_t *, const char *, size_t);
+void nokia5110_display_fill_remaining(nokia5110_spi_device_t *, uint8_t);
+void nokia5110_cleanup(nokia5110_spi_device_t *);
+
+static int nokia5110_open(struct inode *, struct file *);
+static int nokia5110_release(struct inode *, struct file *);
+static ssize_t nokia5110_write(struct file *, const char __user *, size_t, loff_t *);
+
+static struct file_operations fops = {
+    .owner = THIS_MODULE,
+    .open = nokia5110_open,
+    .release = nokia5110_release,
+    .write = nokia5110_write,
+};
+
+static int nokia5110_probe(struct spi_device *spidev) {
+    nokia5110_spi_device_t *nokia5110;
+    char* test_str = "Hello, World!\n";
+
+    printk(KERN_INFO DEVICE_NAME ": Probing SPI device.\n");
+
+    nokia5110 = (nokia5110_spi_device_t *)kmalloc(sizeof(nokia5110_spi_device_t), GFP_KERNEL);
+    if (!nokia5110) {
+        printk(KERN_ERR DEVICE_NAME ": Cannot allocate kernel.\n");
+        return -ENOMEM;
+    }
+
+    nokia5110->kmalloc_ptr = (char *)kmalloc(KBUFFER_CAP, GFP_KERNEL);
+    if (nokia5110->kmalloc_ptr == NULL) {
+        printk(KERN_ERR DEVICE_NAME ": Cannot allocate buffer.\n");
+        goto nokia5110_fail;
+    }
+
+    cdev_init(&nokia5110->my_cdev, &fops);
+    nokia5110->dev_num = MKDEV(MAJOR(nokia5110_module.major), nokia5110_module.minor);
+    if (cdev_add(&nokia5110->my_cdev, nokia5110->dev_num, 1)) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to add device.\n");
+        goto cdev_add_fail;
+    }
+    nokia5110_module.minor++;
+
+    if (device_create(nokia5110_module.my_class, NULL, nokia5110->dev_num, NULL, "%s%d", DEVICE_NAME, MINOR(nokia5110->dev_num)) == NULL) {
+         printk(KERN_ERR DEVICE_NAME ": Cannot create device.\n");
+         goto device_create_fail;
+    }
+
+    nokia5110->rst_gpio = devm_gpiod_get(&spidev->dev, "reset", GPIOD_OUT_LOW);
+    nokia5110->dc_gpio = devm_gpiod_get(&spidev->dev, "dc", GPIOD_OUT_LOW);
+    if (IS_ERR(nokia5110->rst_gpio) || IS_ERR(nokia5110->dc_gpio)) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to get DC and RESET gpio.\n");
+        goto device_create_fail;
+    }
+    gpiod_set_value(nokia5110->rst_gpio, 1);
+
+    nokia5110->kbuf_len = 0;
+    nokia5110->spidev = spidev;
+    nokia5110->current_line = 0;
+    nokia5110->cursor_pos = 0;
+    nokia5110->font_size = 5 + NOKIA5110_FONT_SPACING;
+
+    spi_set_drvdata(spidev, nokia5110);
+    nokia5110_init_sequence(nokia5110);
+    nokia5110_cleanup(nokia5110);
+    nokia5110_display_print_string(nokia5110, test_str, sizeof(test_str));
+
+    printk(KERN_INFO DEVICE_NAME ": SPI device is detected.\n");
+    return 0;
+
+    device_create_fail:
+    cdev_del(&nokia5110->my_cdev);
+    cdev_add_fail:
+    kfree(nokia5110->kmalloc_ptr);
+    nokia5110_fail:
+    kfree(nokia5110->kmalloc_ptr);
+    return -1;
+}
+
+static int nokia5110_remove(struct spi_device *spidev) {
+    nokia5110_spi_device_t *nokia5110 = spi_get_drvdata(spidev);
+    if (!nokia5110) {
+        printk(KERN_INFO DEVICE_NAME ": Error geting driver data.\n");
+        return -EINVAL;
+    }
+
+    device_destroy(nokia5110_module.my_class, nokia5110->dev_num);
+    cdev_del(&nokia5110->my_cdev);
+    kfree(nokia5110->kmalloc_ptr);
+    kfree(nokia5110);
+
+    printk(KERN_INFO DEVICE_NAME ": I2C device is removed.\n");
+    return 0;
+}
+
+void nokia5110_init_sequence(nokia5110_spi_device_t *nokia5110) {
+    nokia5110_send_cmd(nokia5110, 0x21); // extended instruction set
+	nokia5110_send_cmd(nokia5110, 0xB1); // set Vop
+	nokia5110_send_cmd(nokia5110, 0x04); // temperature coeff
+	nokia5110_send_cmd(nokia5110, 0x14); // bias
+	nokia5110_send_cmd(nokia5110, 0x20); // basic instruction set
+	nokia5110_send_cmd(nokia5110, 0x0C); // normal display mode
+}
+
+static int nokia5110_send_cmd(nokia5110_spi_device_t *nokia5110, uint8_t command) {
+    gpiod_set_value(nokia5110->dc_gpio, 0);
+    return spi_write(nokia5110->spidev, &command, 1);
+}
+
+static int nokia5110_send_data(nokia5110_spi_device_t *nokia5110, char *data_buf, size_t buf_len) {
+    gpiod_set_value(nokia5110->dc_gpio, 1);
+	return spi_write(nokia5110->spidev, data_buf, buf_len);
+}
+
+static int nokia5110_set_column_address(nokia5110_spi_device_t *nokia5110, uint8_t x, uint8_t y) {
+    if (x > NOKIA5110_MAX_COLUMN || y > NOKIA5110_MAX_BANK) {
+        return -1;
+    }
+    nokia5110_send_cmd(nokia5110, PCD8544_CMD_SET_X_ADDR | x);
+    nokia5110_send_cmd(nokia5110, PCD8544_CMD_SET_Y_ADDR | y);
+    return 0;
+}
+
+void nokia5110_display_print_string(nokia5110_spi_device_t *nokia5110, const char *str, size_t len) {
+    char *str_temp;
+    char *kbuffer;
+    size_t i, j;
+    uint16_t kbuf_index = 0;
+
+    str_temp = (char *)kmalloc(len + 1, GFP_KERNEL);
+    if (!str_temp) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to allocate memory for string copy.\n");
+        return;
+    }
+    strncpy(str_temp, str, len);
+    str_temp[len] = '\0';
+
+    kbuffer = (char *)kmalloc(nokia5110->font_size * len, GFP_KERNEL);
+    if (!kbuffer) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to allocate memory for string rendering.\n");
+        return;
+    }
+
+    for (i = 0; i < len; i++) {
+        if (str_temp[i] == '\n') {
+            nokia5110_display_fill_remaining(nokia5110, nokia5110->cursor_pos);
+            nokia5110->current_line++;
+            nokia5110->cursor_pos = 0;
+            if (nokia5110->current_line > NOKIA5110_MAX_BANK) {
+                nokia5110->current_line = 0;
+            }
+            nokia5110_set_column_address(nokia5110, nokia5110->current_line, nokia5110->cursor_pos);
+            continue;
+        } else if (str_temp[i] < 0x20 || str_temp[i] > 0x7E) {
+            str_temp[i] = '?'; // Replace unsupported characters with '?'
+        }
+
+        // Render characters to kbuffer
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][0];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][1];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][2];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][3];
+        kbuffer[kbuf_index++] = font5x8[str_temp[i] - 0x20][4];
+        for (j = 0; j < NOKIA5110_FONT_SPACING; j++) {
+            kbuffer[kbuf_index++] = 0x00; // Add spacing between characters
+        }
+
+        nokia5110_send_data(nokia5110, kbuffer, nokia5110->font_size);
+        kbuf_index = 0;
+        nokia5110->cursor_pos += nokia5110->font_size;
+
+        // Prepare for next character
+        if (nokia5110->cursor_pos + nokia5110->font_size > NOKIA5110_MAX_COLUMN) {
+            nokia5110_display_fill_remaining(nokia5110, nokia5110->cursor_pos);
+            nokia5110->current_line++;
+            nokia5110->cursor_pos = 0;
+            if (nokia5110->current_line > NOKIA5110_MAX_BANK) {
+                nokia5110->current_line = 0;
+            }
+        }
+        nokia5110_set_column_address(nokia5110, nokia5110->current_line, nokia5110->cursor_pos);
+    }
+}
+
+void nokia5110_display_fill_remaining(nokia5110_spi_device_t *nokia5110, uint8_t pos) {
+    uint8_t remaining_bytes = NOKIA5110_MAX_COLUMN - pos;
+    char *clear_buf;
+
+    clear_buf = (char *)kmalloc(remaining_bytes, GFP_KERNEL);
+    if (!clear_buf) {
+        printk(KERN_ERR DEVICE_NAME ": Failed to allocate memory for clearing display.\n");
+        return;
+    }
+    
+    memset(clear_buf, 0x00, remaining_bytes);
+    printk(KERN_INFO DEVICE_NAME ": Filling remaining %d bytes on line %d from position %d\n", remaining_bytes, nokia5110->current_line, pos);
+
+    nokia5110_send_data(nokia5110, clear_buf, remaining_bytes);
+    kfree(clear_buf);
+}
+
+void nokia5110_cleanup(nokia5110_spi_device_t *nokia5110) {
+    int line;
+
+    for (line = 0; line <= NOKIA5110_MAX_BANK; line++) {
+        nokia5110_set_column_address(nokia5110, line, 0);
+        nokia5110_display_fill_remaining(nokia5110, 0);
+    }
+    nokia5110_set_column_address(nokia5110, 0, 0);
+}
+
+static int nokia5110_open(struct inode *inode, struct file *file) {
+    nokia5110_spi_device_t *nokia5110 = container_of(inode->i_cdev, nokia5110_spi_device_t, my_cdev);
+    file->private_data = nokia5110;
+
+    printk(KERN_INFO DEVICE_NAME ": open\n");
+    return 0;
+}
+
+static int nokia5110_release(struct inode *inode, struct file *file) {
+    printk(KERN_INFO DEVICE_NAME ": release\n");
+    return 0;
+}
+
+static ssize_t nokia5110_write(struct file *file, const char __user *user_buf, size_t size, loff_t *offset) {
+    nokia5110_spi_device_t *nokia5110 = (nokia5110_spi_device_t *)file->private_data;
+
+    int bytes_write = size;
+    if (size > KBUFFER_CAP - 1) {
+        bytes_write = KBUFFER_CAP - 1;
+    }
+    if (copy_from_user(nokia5110->kmalloc_ptr, user_buf, bytes_write)) {
+        return -1;
+    }
+    nokia5110->kmalloc_ptr[bytes_write] = '\0';
+    nokia5110_display_print_string(nokia5110, nokia5110->kmalloc_ptr, bytes_write);
+    printk(KERN_INFO DEVICE_NAME ": received %d bytes from user\n", bytes_write);
+
+    return bytes_write;
+}
+
+static const struct of_device_id nokia5110_of_match[] = {
+    { .compatible = "nokia5110" },
+    { }
+};
+
+static struct spi_driver nokia5110_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .owner = THIS_MODULE,
+        .of_match_table = nokia5110_of_match
+    },
+    .probe = nokia5110_probe,
+    .remove = nokia5110_remove,
+};
+
+static int __init nokia5110_init(void) {   
+    if ((nokia5110_module.my_class = class_create(THIS_MODULE, CLASS_NAME)) == NULL) {
+        printk(KERN_ERR DEVICE_NAME ": Cannot create class.\n");
+        return -1;
+    }
+
+    if (alloc_chrdev_region(&nokia5110_module.major, 0, MAX_MINOR, DEVICE_NAME) < 0) {
+        printk(KERN_ERR DEVICE_NAME ": Cannot allocate kernel device.\n");
+        class_destroy(nokia5110_module.my_class);
+        return -1;
+    }
+    nokia5110_module.minor = 0;
+
+    if (spi_register_driver(&nokia5110_driver)) {
+        printk(KERN_ERR DEVICE_NAME ": Cannot register SPI driver.\n");
+        unregister_chrdev_region(nokia5110_module.major, MAX_MINOR);
+        class_destroy(nokia5110_module.my_class);
+        return -1;
+    }
+
+    printk(KERN_INFO DEVICE_NAME ": Hello, Kernel World 12345!\n");
+    return 0;
+}
+
+static void __exit nokia5110_exit(void) {
+    spi_unregister_driver(&nokia5110_driver);
+    class_destroy(nokia5110_module.my_class);
+    unregister_chrdev_region(nokia5110_module.major, MAX_MINOR);
+    printk(KERN_INFO DEVICE_NAME ": Module removed.\n");
+}
+
+module_init(nokia5110_init);
+module_exit(nokia5110_exit);
+
+// Module metadata
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("DataD");
+MODULE_DESCRIPTION("A simple nokia5110 driver");
