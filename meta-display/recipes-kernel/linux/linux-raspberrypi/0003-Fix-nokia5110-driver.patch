@@ -328,12 +328,23 @@ &spi0 {
 	pinctrl-0 = <&spi0_pins &spi0_cs_pins>;
 	cs-gpios = <&gpio 8 1>, <&gpio 7 1>;
 
-	spidev0: spidev@0{
-		compatible = "spidev";
+	// spidev0: spidev@0{
+	// 	compatible = "spidev";
+	// 	reg = <0>;	/* CE0 */
