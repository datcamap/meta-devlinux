+
+static int sh1106_probe(struct i2c_client *client);
+static int sh1106_remove(struct i2c_client *client);
+void sh1106_init_sequence(sh1106_i2c_device_t *);
+static int sh1106_send_command(sh1106_i2c_device_t *, uint8_t);
+static int sh1106_send_data(sh1106_i2c_device_t *, char*, uint16_t);
+static int sh1106_set_cursor(sh1106_i2c_device_t *, uint8_t, uint8_t);
+void sh1106_display_print_string(sh1106_i2c_device_t *, const char *, size_t);
+void sh1106_display_fill_remaining(sh1106_i2c_device_t *, uint8_t);
+void sh1106_cleanup(sh1106_i2c_device_t *);
+
+static int sh1106_open(struct inode *, struct file *);
+static int sh1106_release(struct inode *, struct file *);
+static ssize_t sh1106_write(struct file *, const char __user *, size_t, loff_t *);
+
+static struct file_operations fops = {
+    .open = sh1106_open,
+    .release = sh1106_release,
+    .write = sh1106_write,
+};
+
+static int sh1106_probe(struct i2c_client *client) {
+    sh1106_i2c_device_t *sh1106;
+    char* test_str = "Hello, World!\n";
+
+    sh1106 = (sh1106_i2c_device_t *)kmalloc(sizeof(sh1106_i2c_device_t), GFP_KERNEL);
+    if (!sh1106) {
+        return -ENOMEM;
+    }
+
+    sh1106->kmalloc_ptr = (char *)kmalloc(KBUFFER_CAP, GFP_KERNEL);
+    if (sh1106->kmalloc_ptr == NULL) {
+        SH1106_PRINTK(KERN_ERR, "Cannot allocate kernel buffer.\n");
+        goto sh1106_fail;
+    }
+
+    cdev_init(&sh1106->my_cdev, &fops);
+    sh1106->dev_num = MKDEV(MAJOR(sh1106_module.major), sh1106_module.minor);
+    if (cdev_add(&sh1106->my_cdev, sh1106->dev_num, 1)) {
+        SH1106_PRINTK(KERN_ERR, "Failed to add device.\n");
+        goto cdev_add_fail;
+    }
+    sh1106_module.minor++;
+
+    if (device_create(sh1106_module.my_class, NULL, sh1106->dev_num, NULL, "%s%d", DEVICE_NAME, MINOR(sh1106->dev_num)) == NULL) {
+         SH1106_PRINTK(KERN_ERR, "Cannot create device.\n");
+         goto device_create_fail;
+    }
+
+    sh1106->kbuf_len = 0;
+    sh1106->client = client;
+    sh1106->current_line = 0;
+    sh1106->cursor_pos = 0;
+    sh1106->font_size = 5 + SH1106_FONT_SPACING;
+
+    i2c_set_clientdata(client, sh1106);
+    sh1106_init_sequence(sh1106);
+    sh1106_cleanup(sh1106);
+    sh1106_display_print_string(sh1106, test_str, sizeof(test_str) - 1);
+
+    SH1106_PRINTK(KERN_INFO, "I2C device is detected.\n");
+    return 0;
+
+device_create_fail:
+    cdev_del(&sh1106->my_cdev);
+cdev_add_fail:
+    kfree(sh1106->kmalloc_ptr);
+sh1106_fail:
+    kfree(sh1106);
+    return -1;
+}
+
+static int sh1106_remove(struct i2c_client *client) {
+    sh1106_i2c_device_t *sh1106 = i2c_get_clientdata(client);
+    if (!sh1106) {
+        return -EINVAL;
+    }
+
+    sh1106_module.minor--;
+    device_destroy(sh1106_module.my_class, sh1106->dev_num);
+    cdev_del(&sh1106->my_cdev);
+    kfree(sh1106->kmalloc_ptr);
+    kfree(sh1106);
+
+    SH1106_PRINTK(KERN_INFO, "I2C device is removed.\n");
+    return 0;
+}
+
+void sh1106_init_sequence(sh1106_i2c_device_t *sh1106) {
+    sh1106_send_command(sh1106, 0xAE); // Set display OFF		
+ 
+    sh1106_send_command(sh1106, 0xD5); // Set Display Clock Divide Ratio / OSC Frequency
+    sh1106_send_command(sh1106, 0x80); // Display Clock Divide Ratio / OSC Frequency 
+ 
+    sh1106_send_command(sh1106, SH1106_MULTIPLEX_RATIO);
+    sh1106_send_command(sh1106, 0x3F);
+
+    sh1106_send_command(sh1106, SH1106_DISPLAY_OFFSET);
+    sh1106_send_command(sh1106, 0x00);
+    
+    // sh1106_send_command(sh1106, 0x21); // Set column address
+    // sh1106_send_command(sh1106, 0x00); // Column start address
+    // sh1106_send_command(sh1106, 0x7F); // Column end address
+
+    sh1106_send_command(sh1106, SH1106_START_LINE | 0x0);
+ 
+    sh1106_send_command(sh1106, 0x8D); // Set Charge Pump
+    sh1106_send_command(sh1106, 0x14); // Charge Pump (0x10 External, 0x14 Internal DC/DC)
+ 
+    sh1106_send_command(sh1106, 0xA0 | 0x1); // Set Segment Re-Map
+    sh1106_send_command(sh1106, 0xC8); // Set Com Output Scan Direction
+ 
+    sh1106_send_command(sh1106, 0xDA); // Set COM Hardware Configuration
+    sh1106_send_command(sh1106, 0x12); // COM Hardware Configuration
+ 
+    sh1106_send_command(sh1106, SH1106_CONTRAST);
+    sh1106_send_command(sh1106, 0xCF);
+ 
+    sh1106_send_command(sh1106, 0xD9); // Set Pre-Charge Period
+    sh1106_send_command(sh1106, 0xF1); // Set Pre-Charge Period (0x22 External, 0xF1 Internal)
+ 
+    sh1106_send_command(sh1106, 0xDB); // Set VCOMH Deselect Level
+    sh1106_send_command(sh1106, 0x40); // VCOMH Deselect Level
+ 
+    sh1106_send_command(sh1106, 0xA4); // Set all pixels OFF
+    sh1106_send_command(sh1106, 0xA6); // Set display not inverted
+    sh1106_send_command(sh1106, 0xAF); // Set display On
+    msleep(100);
+}
+
+static int sh1106_send_command(sh1106_i2c_device_t *sh1106, uint8_t command) {
+    char buf[2];
+    buf[0] = SH1106_CTRL_CMD;
+    buf[1] = command;
+    return i2c_master_send(sh1106->client, buf, 2);
+}
+
+static int sh1106_send_data(sh1106_i2c_device_t *sh1106, char *data_buf, uint16_t buf_len) {
+    while (buf_len > 0) {
+        int chunk_len = min((int)buf_len, 16);
+        uint8_t buf[1 + 16];
+        int ret;
+
+        buf[0] = SH1106_CTRL_DATA;
+        memcpy(&buf[1], data_buf, chunk_len);
+
+        ret = i2c_master_send(sh1106->client, buf, chunk_len + 1);
+        if (ret != chunk_len + 1) {
+            return (ret < 0) ? ret : -EIO;
+        }
+
+        data_buf += chunk_len;
+        buf_len  -= chunk_len;
+    }
+
+    return 0;
+}
+
+static int sh1106_set_cursor(sh1106_i2c_device_t *sh1106, uint8_t line, uint8_t pos) {
+    if (line > SH1106_MAX_LINE || pos > SH1106_MAX_SEG) {
+        SH1106_PRINTK(KERN_ERR, "Invalid cursor position (line: %d, pos: %d)\n", line, pos);
+        return -EINVAL;
+    }
+    sh1106->current_line = line;
+    sh1106->cursor_pos = pos + SH1106_COLUMN_OFFSET;
+
+    sh1106_send_command(sh1106, SH1106_LINE_ADDR | sh1106->current_line);
+
+    sh1106_send_command(sh1106, SH1106_COLUMN_LOW_ADDR | (sh1106->cursor_pos & 0x0F));
+
+    sh1106_send_command(sh1106, SH1106_COLUMN_HIGH_ADDR | ((sh1106->cursor_pos >> 4) & 0x0F));
+
+    SH1106_PRINTK(KERN_INFO, "Cursor set to line %d, pos %d\n", sh1106->current_line, sh1106->cursor_pos);
+    
+    // msleep(1); // Small delay to ensure commands are processed
+    return 0;
+}
+
+void sh1106_display_print_string(sh1106_i2c_device_t *sh1106, const char *str, size_t len) {
+    char *str_temp;
+    char *kbuffer;
+    size_t i, j;
+    uint16_t kbuf_index = 0;
+
+    str_temp = (char *)kmalloc(len + 1, GFP_KERNEL);
+    if (!str_temp) {
+        SH1106_PRINTK(KERN_ERR, "Failed to allocate memory for string copy.\n");
+        return;
+    }
+    strncpy(str_temp, str, len);
+    str_temp[len] = '\0';
+
+    kbuffer = (char *)kmalloc(sh1106->font_size * len, GFP_KERNEL);
+    if (!kbuffer) {
+        SH1106_PRINTK(KERN_ERR, "Failed to allocate memory for string rendering.\n");
+        kfree(str_temp);
+        return;
+    }
+
+    for (i = 0; i < len; i++) {
+        if (str_temp[i] == '\n') {
+            sh1106_display_fill_remaining(sh1106, sh1106->cursor_pos);
+            sh1106->current_line++;
+            sh1106->cursor_pos = 0;
+            if (sh1106->current_line > SH1106_MAX_LINE) {
+                sh1106->current_line = 0;
+            }
+            sh1106_set_cursor(sh1106, sh1106->current_line, sh1106->cursor_pos);
+            continue;
+        } else if (str_temp[i] < 0x20 || str_temp[i] > 0x7E) {
+            str_temp[i] = '?'; // Replace unsupported characters with '?'
+        }
+
+        // Render character to kbuffer
+        for (j = 0; j < 5; j++) {
+            if (str_temp[i] == ' ' || font5x8[str_temp[i]-0x20][j] != 0x00) {
+                kbuffer[kbuf_index] = font5x8[str_temp[i]-0x20][j];
+                kbuf_index++;
+            }
+        }
+        for (j = 0; j < SH1106_FONT_SPACING; j++) {
+            kbuffer[kbuf_index++] = 0x00;
+        }
+
+        // Send data for this character
+        sh1106_send_data(sh1106, kbuffer, kbuf_index);
+        kbuf_index = 0;
+        sh1106->cursor_pos += sh1106->font_size;
+
+        // Prepare for next character
+        if (sh1106->cursor_pos + sh1106->font_size > SH1106_MAX_SEG) {
+            sh1106_display_fill_remaining(sh1106, sh1106->cursor_pos);
+            sh1106->current_line++;
+            sh1106->cursor_pos = 0;
+            if (sh1106->current_line > SH1106_MAX_LINE) {
+                sh1106->current_line = 0;
+            }
+        }
+        sh1106_set_cursor(sh1106, sh1106->current_line, sh1106->cursor_pos);
+    }
+
+    kfree(kbuffer);
+    kfree(str_temp);
+}
+
+void sh1106_display_fill_remaining(sh1106_i2c_device_t *sh1106, uint8_t pos) {
+    uint8_t remaining_bytes = SH1106_MAX_SEG - pos;
+    char *clear_buf;
+
+    clear_buf = (char *)kmalloc(remaining_bytes, GFP_KERNEL);
+    if (!clear_buf) {
+        SH1106_PRINTK(KERN_ERR, "Failed to allocate memory for clearing display.\n");
+        return;
+    }
+    
+    memset(clear_buf, 0x00, remaining_bytes);
+    SH1106_PRINTK(KERN_INFO, "Filling remaining %d bytes on line %d from position %d\n", remaining_bytes, sh1106->current_line, pos);
+
+    sh1106_send_data(sh1106, clear_buf, remaining_bytes);
+    kfree(clear_buf);
+}
+
+void sh1106_cleanup(sh1106_i2c_device_t *sh1106) {
+    int line;
+
+    for (line = 0; line <= SH1106_MAX_LINE; line++) {
+        sh1106_set_cursor(sh1106, line, 0);
+        sh1106_display_fill_remaining(sh1106, 0);
+    }
+    sh1106_set_cursor(sh1106, 0, 0);
+}
+
+static int sh1106_open(struct inode *inode, struct file *file) {
+    sh1106_i2c_device_t *sh1106 = container_of(inode->i_cdev, sh1106_i2c_device_t, my_cdev);
+    file->private_data = sh1106;
+
+    SH1106_PRINTK(KERN_INFO, "open\n");
+    return 0;
+}
+
+static int sh1106_release(struct inode *inode, struct file *file) {
+    SH1106_PRINTK(KERN_INFO, "release\n");
+    return 0;
+}
+
+static ssize_t sh1106_write(struct file *file, const char __user *user_buf, size_t size, loff_t *offset) {
+    sh1106_i2c_device_t *sh1106 = (sh1106_i2c_device_t *)file->private_data;
+
+    int bytes_write = size;
+    if (size > KBUFFER_CAP - 1) {
+        bytes_write = KBUFFER_CAP - 1;
+    }
+    if (copy_from_user(sh1106->kmalloc_ptr, user_buf, bytes_write)) {
+        return -1;
+    }
+    sh1106->kmalloc_ptr[bytes_write] = '\0';
+    sh1106_display_print_string(sh1106, sh1106->kmalloc_ptr, bytes_write);
+    SH1106_PRINTK(KERN_INFO, "received %d bytes from user\n", bytes_write);
+
+    return bytes_write;
+}
+
+static const struct of_device_id sh1106_of_match[] = {
+    { .compatible = "solomon,sh1106" },
+    { }
+};
+
+static struct i2c_driver sh1106_driver = {
+    .driver = {
+        .name = DEVICE_NAME,
+        .owner = THIS_MODULE,
+        .of_match_table = sh1106_of_match
+    },
+    .probe_new = sh1106_probe,
+    .remove = sh1106_remove,
+};
+
+static int __init sh1106_init(void)
+{   
+    if ((sh1106_module.my_class = class_create(THIS_MODULE, CLASS_NAME)) == NULL) {
+        SH1106_PRINTK(KERN_ERR, "Cannot create class.\n");
+        return -1;
+    }
+    if (alloc_chrdev_region(&sh1106_module.major, 0, MAX_MINOR, DEVICE_NAME) < 0) {
+        SH1106_PRINTK(KERN_ERR, "Cannot allocate kernel device.\n");
+        class_destroy(sh1106_module.my_class);
+        return -1;
+    }
+    sh1106_module.minor = 0;
+    
+    if (i2c_add_driver(&sh1106_driver)) {
+        SH1106_PRINTK(KERN_ERR, "i2c_add_driver failed. \n");
+        class_destroy(sh1106_module.my_class);
+        unregister_chrdev_region(sh1106_module.major, MAX_MINOR);
+        return -1;
+    }
+
+    SH1106_PRINTK(KERN_INFO, "Hello, Kernel World!\n");
+    return 0;
+}
+
+static void __exit sh1106_exit(void)
+{
+    i2c_del_driver(&sh1106_driver);
+
+    class_destroy(sh1106_module.my_class);
+    unregister_chrdev_region(sh1106_module.major, MAX_MINOR);
+    SH1106_PRINTK(KERN_INFO, "Module removed.\n");
+}
+
+module_init(sh1106_init);
+module_exit(sh1106_exit);
+
+// Module metadata
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("DataD");
+MODULE_DESCRIPTION("A simple sh1106 driver");
